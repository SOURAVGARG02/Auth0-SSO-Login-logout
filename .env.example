PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-this-with-a-unique-random-value-at-least-32-characters

SAML_ISSUER=urn:paxafe:saml-demo
SAML_CALLBACK_URL=http://localhost:3000/auth/saml/acs
SAML_ENTRY_POINT=https://YOUR_AUTH0_DOMAIN/samlp/YOUR_SAML_APP_ID
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nPASTE_AUTH0_SIGNING_CERTIFICATE_HERE\n-----END CERTIFICATE-----"

# Optional: connection hint for Auth0 and the direct IdP-initiated launch URL.
AUTH0_SAML_CONNECTION=
AUTH0_IDP_INITIATED_URL=

# Optional: configure SAML Single Logout. Keep blank unless your IdP supports SLO.
# All three values are required; the app must be reachable over HTTPS.
SAML_LOGOUT_URL=
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_SP_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
SAML_SP_CERT="-----BEGIN CERTIFICATE-----\nPASTE_SP_CERTIFICATE_HERE\n-----END CERTIFICATE-----"

# Optional fallback when SAML Single Logout is not configured.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
